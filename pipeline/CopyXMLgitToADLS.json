{
	"name": "CopyXMLgitToADLS",
	"properties": {
		"activities": [
			{
				"name": "CopyFromGitToADLS",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "XmlSource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET"
						},
						"formatSettings": {
							"type": "XmlReadSettings",
							"validationMode": "none",
							"namespaces": true
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "XMLgitDataset",
						"type": "DatasetReference",
						"parameters": {
							"relativeURL": "ADFandDatabricksProject-2/refs/heads/main/data/departments.xml"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ParquetXMLDateset",
						"type": "DatasetReference",
						"parameters": {
							"container": "bronze",
							"dir": "xml",
							"file": "departments"
						}
					}
				]
			}
		],
		"annotations": []
	}
}